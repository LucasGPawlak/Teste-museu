<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Museu Virtual - Galeria 360º</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            font-family: Arial, sans-serif;
            background-color: #000;
        }
        #canvas-container {
            width: 100vw;
            height: 100vh;
        }
        #ui {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            color: #333;
            background: rgba(255, 255, 255, 0.85);
            padding: 10px 20px;
            border-radius: 20px;
            pointer-events: none;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            font-size: 14px;
            text-align: center;
            z-index: 10;
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
</head>
<body>

    <div id="ui">
        Clique e arraste para girar a visão 360º | Scroll do mouse para Zoom
    </div>
    <div id="canvas-container"></div>

    <script>
        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0xf0f0f0);

        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 2, 0.1);

        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        container.appendChild(renderer.domElement);

        const controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableZoom = true;
        controls.minDistance = 0.5;
        controls.maxDistance = 12;
        controls.enablePan = false;
        controls.maxPolarAngle = Math.PI / 2 + 0.05;
        controls.rotateSpeed = -0.5;

        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambientLight);

        const mainLight = new THREE.PointLight(0xfff5e6, 1.2, 30);
        mainLight.position.set(0, 5.8, 0);
        mainLight.castShadow = true;
        scene.add(mainLight);

        const wallMaterial = new THREE.MeshStandardMaterial({ color: 0xeaeaea, roughness: 0.8 });
        const floorMaterial = new THREE.MeshStandardMaterial({ color: 0xd0c8b8, roughness: 0.3, metalness: 0.1 });
        const ceilingMaterial = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.9 });
        const frameMaterial = new THREE.MeshStandardMaterial({ color: 0x222222, roughness: 0.5 });

        const roomWidth = 16;
        const roomHeight = 6;
        const roomDepth = 16;

        const floor = new THREE.Mesh(new THREE.PlaneGeometry(roomWidth, roomDepth), floorMaterial);
        floor.rotation.x = -Math.PI / 2;
        floor.receiveShadow = true;
        scene.add(floor);

        const ceiling = new THREE.Mesh(new THREE.PlaneGeometry(roomWidth, roomDepth), ceilingMaterial);
        ceiling.rotation.x = Math.PI / 2;
        ceiling.position.y = roomHeight;
        scene.add(ceiling);

        const backWall = new THREE.Mesh(new THREE.PlaneGeometry(roomWidth, roomHeight), wallMaterial);
        backWall.position.set(0, roomHeight / 2, -roomDepth / 2);
        scene.add(backWall);

        const frontWall = new THREE.Mesh(new THREE.PlaneGeometry(roomWidth, roomHeight), wallMaterial);
        frontWall.position.set(0, roomHeight / 2, roomDepth / 2);
        frontWall.rotation.y = Math.PI;
        scene.add(frontWall);

        const leftWall = new THREE.Mesh(new THREE.PlaneGeometry(roomDepth, roomHeight), wallMaterial);
        leftWall.position.set(-roomWidth / 2, roomHeight / 2, 0);
        leftWall.rotation.y = Math.PI / 2;
        scene.add(leftWall);

        const rightWall = new THREE.Mesh(new THREE.PlaneGeometry(roomDepth, roomHeight), wallMaterial);
        rightWall.position.set(roomWidth / 2, roomHeight / 2, 0);
        rightWall.rotation.y = -Math.PI / 2;
        scene.add(rightWall);

        const createColumn = (x, z) => {
            const colGeo = new THREE.BoxGeometry(1.5, roomHeight, 1.5);
            const column = new THREE.Mesh(colGeo, wallMaterial);
            column.position.set(x, roomHeight / 2, z);
            column.castShadow = true;
            column.receiveShadow = true;
            scene.add(column);
            return column;
        };

        createColumn(-4, -4);
        createColumn(4, -4);
        createColumn(-4, 4);
        createColumn(4, 4);

        function createPhotoTexture(text, color) {
            const canvas = document.createElement('canvas');
            canvas.width = 512;
            canvas.height = 512;
            const ctx = canvas.getContext('2d');
            
            ctx.fillStyle = color;
            ctx.fillRect(0, 0, 512, 512);
            
            ctx.fillStyle = '#ffffff';
            ctx.font = '36px Arial';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(text, 256, 256);

            return new THREE.CanvasTexture(canvas);
        }

        function addPainting(x, y, z, rotationY, width, height, title, color) {
            const group = new THREE.Group();

            const frameGeo = new THREE.BoxGeometry(width + 0.1, height + 0.1, 0.05);
            const frame = new THREE.Mesh(frameGeo, frameMaterial);
            frame.castShadow = true;
            group.add(frame);

            const photoGeo = new THREE.PlaneGeometry(width, height);
            const photoMat = new THREE.MeshBasicMaterial({ 
                map: createPhotoTexture(title, color) 
            });
            const photo = new THREE.Mesh(photoGeo, photoMat);
            photo.position.z = 0.03;
            group.add(photo);

            const spotLight = new THREE.SpotLight(0xfff8e7, 1.5);
            spotLight.position.set(0, 1.5, 1.5);
            spotLight.target = photo;
            spotLight.angle = Math.PI / 4;
            spotLight.penumbra = 0.5;
            group.add(spotLight);

            group.position.set(x, y, z);
            group.rotation.y = rotationY;
            scene.add(group);
        }

        addPainting(0, 2.5, -7.9, 0, 3, 2, "Obra 01", "#4a90e2");
        addPainting(-5, 2.5, -7.9, 0, 2, 2.5, "Obra 02", "#e67e22");
        addPainting(5, 2.5, -7.9, 0, 2, 2.5, "Obra 03", "#2ecc71");

        addPainting(-7.9, 2.5, 0, Math.PI / 2, 3, 2, "Obra 04", "#9b59b6");
        addPainting(7.9, 2.5, 0, -Math.PI / 2, 3, 2, "Obra 05", "#f1c40f");

        addPainting(-4, 2.5, -3.2, 0, 1, 1.2, "Coluna A1", "#e74c3c");
        addPainting(-3.2, 2.5, -4, Math.PI / 2, 1, 1.2, "Coluna A2", "#1abc9c");
        addPainting(4, 2.5, -3.2, 0, 1, 1.2, "Coluna B1", "#34495e");
        addPainting(3.2, 2.5, -4, -Math.PI / 2, 1, 1.2, "Coluna B2", "#d35400");
        addPainting(-4, 2.5, 3.2, Math.PI, 1, 1.2, "Coluna C1", "#27ae60");
        addPainting(4, 2.5, 3.2, Math.PI, 1, 1.2, "Coluna D1", "#8e44ad");

        window.addEventListener('resize', onWindowResize, false);

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function animate() {
            requestAnimationFrame(animate);
            controls.update();
            renderer.render(scene, camera);
        }

        animate();
    </script>
</body>
</html>
